import("../../../config.gni")

declare_args() {
  root_path = rebase_path("../../..")
}

source_set("LynxTextra") {
  # Package host platform adapters without importing optional rendering
  # backends into the native module's public umbrella header.
  public = []
  sources = [
    "$root_path/public/textra/platform/skia/skia_canvas_helper.h",
    "$root_path/public/textra/platform/skia/skia_font_manager.h",
    "$root_path/public/textra/platform/skia/skia_gradient.h",
    "$root_path/public/textra/platform/skia/skia_painter.h",
    "$root_path/public/textra/platform/skia/skia_typeface_helper.h",
    "$root_path/public/textra/platform/skity/skity_canvas_helper.h",
    "$root_path/public/textra/platform/skity/skity_font_data.h",
    "$root_path/public/textra/platform/skity/skity_font_manager.h",
    "$root_path/public/textra/platform/skity/skity_font_manager_coretext.h",
    "$root_path/public/textra/platform/skity/skity_font_manager_coretext_webkit.h",
    "$root_path/public/textra/platform/skity/skity_gradient.h",
    "$root_path/public/textra/platform/skity/skity_typeface_helper.h",
  ]
  include_dirs = [
    "$root_path/public",
    "//ROOT",
  ]

  defines = [ "TTTEXT_OS_IOS" ]
  if (use_lru_cache) {
    defines += [ "USE_LRU_CACHE=1" ]
  }

  metadata = {
    header_mappings_dir = [ "public" ]
  }

  deps = [
    "$root_path/src:bidi",
    "$root_path/src:capi",
    "$root_path/src:textlayout",
  ]
}
group("LynxTextra_podspecs_group") {
  deps = [ ":LynxTextra" ]
}
group("LynxTextra_subspecs_group") {
  deps = []
}

source_set("get_ios_base_configs") {
  sources = []
}
