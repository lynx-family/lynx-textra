import("//config.gni")

# Windows has no published SDK target yet. Link the library's C API, without
# benchmark code, and explicitly retain every exported API in both revisions.
shared_library("size_library") {
  output_name = "lynxtextra"
  sources = []
  deps = [
    "//src:bidi",
    "//src:capi",
  ]
  ldflags = [ "/DEF:" + rebase_path("textra.def", root_build_dir) ]
}
