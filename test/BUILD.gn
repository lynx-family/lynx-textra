import("//config.gni")

group("test") {
  testonly = true
  deps = [
    ":TextLayoutLiteTest",
    ":backend_test",
    ":capi_test",
    ":script_shaping_test",
    ":unicode_script_test",
  ]
  if (is_mac) {
    deps += [
      ":backend_error_test",
      ":font_features_test",
    ]
  }
}

executable("TextLayoutLiteTest") {
  output_name = "TextLayoutLiteTest"
  testonly = true
  sources = [
    "//demos/darwin/macos/ttreaderdemo/paragraph_test.cc",
    "boundary_analyst_test.cc",
    "ellipsis_foreground_color_test.cc",
    "gradient_skity_test.cc",
    "gradient_test.cc",
    "inline_block_test.cc",
    "justify_analyst_test.cc",
    "layout_drawer_test.cc",
    "layout_region_test.cc",
    "one_line_shaper_test.cc",
    "paragraph_image_test.cc",
    "paragraph_style_test.cc",
    "paragraph_test.cc",
    "run_test.cc",
    "script_run_iterator_test.cc",
    "shape_cache_test.cc",
    "shape_test.cc",
    "skity_typeface_helper_test.cc",
    "style_manager_test.cc",
    "style_test.cc",
    "test_src.cc",
    "test_src.h",
    "test_utils.h",
    "text_layout_test.cc",
    "text_test.cc",
    "tt_shaper_test.cc",
    "tttext_context_test.cc",
    "unicode_script_test.cc",
  ]

  include_dirs = [
    "//",
    "//public",
  ]

  deps = [
    "//src:skshaper",
    "//src:textlayout",
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest",
    "//third_party/googletest:gtest_main",
  ]

  frameworks = [
    "AppKit.framework",
    "CoreText.framework",
  ]

  project_root = rebase_path("..")
  golden_images_dir = rebase_path("golden_images")
  defines = [
    "ENABLE_GTEST=1",
    "FONT_ROOT=\"$project_root/fonts/\"",
    "GOLDEN_IMAGES_DIR=\"$golden_images_dir/\"",
  ]

  cflags_cc = [
    "-Wno-unused-function",
    "-Wno-unused-private-field",
  ]
}

# Focused Script iterator and fallback tests without image/golden dependencies.
executable("script_shaping_test") {
  testonly = true
  sources = [
    "one_line_shaper_test.cc",
    "script_run_iterator_test.cc",
  ]
  include_dirs = [
    "//",
    "//public",
  ]
  deps = [
    "//src:skshaper",
    "//src:textlayout",
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest_main",
  ]
  if (is_mac) {
    frameworks = [
      "AppKit.framework",
      "CoreText.framework",
    ]
  }
}

# Script and font-policy tests do not require any platform or font libraries.
executable("unicode_script_test") {
  testonly = true
  sources = [
    "//public/textra/macro.h",
    "//src/ports/shaper/coretext/default_font_policy.h",
    "//src/textlayout/utils/grapheme_utils.h",
    "//src/textlayout/utils/log_util.h",
    "//src/textlayout/utils/u_8_string.cc",
    "//src/textlayout/utils/u_8_string.h",
    "//src/textlayout/utils/unicode_script.h",
    "unicode_script_test.cc",
  ]
  include_dirs = [
    "//",
    "//public",
  ]
  deps = [ "//third_party/googletest:gtest_main" ]
}

# Pure host tests do not require the Skity image-test dependencies.
executable("GradientTest") {
  testonly = true
  sources = [
    "gradient_test.cc",
    "style_manager_test.cc",
    "style_test.cc",
  ]
  include_dirs = [
    "//",
    "//public",
  ]
  deps = [
    "//src:textlayout",
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest_main",
  ]
  if (is_mac) {
    frameworks = [
      "AppKit.framework",
      "CoreText.framework",
    ]
  }
}

if (is_mac) {
  executable("GradientCoreGraphicsTest") {
    testonly = true
    sources = [ "gradient_coregraphics_test.mm" ]
    include_dirs = [
      "//",
      "//public",
    ]
    deps = [
      "//src:textlayout",
      "//third_party/googletest:gtest_main",
    ]
    frameworks = [
      "AppKit.framework",
      "CoreText.framework",
      "CoreGraphics.framework",
    ]
    cflags_objcc = [
      "-fobjc-arc",
      "-mmacosx-version-min=14.0",
    ]
    ldflags = [ "-mmacosx-version-min=14.0" ]
  }
}

if (is_mac) {
  executable("RenderingBackendTest") {
    testonly = true
    sources = [ "rendering_backend_test.cc" ]
    deps = [ "//src:textlayout" ]
    frameworks = [
      "AppKit.framework",
      "CoreText.framework",
      "CoreGraphics.framework",
    ]
  }
  executable("PlatformHelperTest") {
    testonly = true
    sources = [ "platform_helper_test.mm" ]
    cflags_objcc = [ "-fobjc-arc" ]
    deps = [ "//src:textlayout" ]
    frameworks = [
      "AppKit.framework",
      "CoreText.framework",
      "CoreGraphics.framework",
    ]
  }
}

executable("capi_test") {
  testonly = true
  sources = [ "capi/textra_capi_test.c" ]
