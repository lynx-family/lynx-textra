import("//config.gni")

group("test") {
  testonly = true
  deps = [ ":TextLayoutLiteTest" ]
}

executable("TextLayoutLiteTest") {
  output_name = "TextLayoutLiteTest"
  testonly = true
  sources = [
    "//demos/darwin/macos/ttreaderdemo/paragraph_test.cc",
    "boundary_analyst_test.cc",
    "ellipsis_foreground_color_test.cc",
    "gradient_skity_test.cc",
    "gradient_test.cc",
    "inline_block_test.cc",
    "justify_analyst_test.cc",
    "layout_drawer_test.cc",
    "layout_region_test.cc",
    "paragraph_image_test.cc",
    "paragraph_style_test.cc",
    "paragraph_test.cc",
    "run_test.cc",
    "shape_cache_test.cc",
    "shape_test.cc",
    "skity_typeface_helper_test.cc",
    "style_manager_test.cc",
    "style_test.cc",
    "test_src.cc",
    "test_src.h",
    "test_utils.h",
    "text_layout_test.cc",
    "text_test.cc",
    "tt_shaper_test.cc",
    "tttext_context_test.cc",
  ]

  include_dirs = [
    "//",
    "//public",
  ]

  deps = [
    "//src:textlayout",
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest",
    "//third_party/googletest:gtest_main",
  ]

  frameworks = [
    "AppKit.framework",
    "CoreText.framework",
  ]

  project_root = rebase_path("..")
  golden_images_dir = rebase_path("golden_images")
  defines = [
    "ENABLE_GTEST=1",
    "FONT_ROOT=\"$project_root/fonts/\"",
    "GOLDEN_IMAGES_DIR=\"$golden_images_dir/\"",
  ]

  cflags_cc = [
    "-Wno-unused-function",
    "-Wno-unused-private-field",
  ]
}

# Pure host tests do not require the Skity image-test dependencies.
executable("GradientTest") {
  testonly = true
  sources = [
    "gradient_test.cc",
    "style_manager_test.cc",
    "style_test.cc",
  ]
  include_dirs = [
    "//",
    "//public",
  ]
  deps = [
    "//src:textlayout",
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest_main",
  ]
  if (is_mac) {
    frameworks = [
      "AppKit.framework",
      "CoreText.framework",
    ]
  }
}

if (is_mac) {
  executable("GradientCoreGraphicsTest") {
    testonly = true
    sources = [ "gradient_coregraphics_test.mm" ]
    include_dirs = [ "//public" ]
    deps = [
      "//src:textlayout",
      "//third_party/googletest:gtest_main",
    ]
    frameworks = [
      "AppKit.framework",
      "CoreText.framework",
      "CoreGraphics.framework",
    ]
    cflags_objcc = [
      "-fobjc-arc",
      "-mmacosx-version-min=14.0",

      # mac_canvas_base.h contains an existing unused local.
      "-Wno-unused-variable",
    ]
    ldflags = [ "-mmacosx-version-min=14.0" ]
  }
}
