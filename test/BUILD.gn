if (is_mac) {
  executable("backend_error_test") {
    testonly = true
    sources = [ "capi/textra_backend_error_test.mm" ]
    deps = [ "//src:capi" ]
    cflags_objcc = [ "-fobjc-arc" ]
    frameworks = [
