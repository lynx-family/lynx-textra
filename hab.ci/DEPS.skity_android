import json
import os

with open(os.path.join(os.getcwd(), "hab.ci/skity.json")) as lock_file:
    release = json.load(lock_file)
artifact = release["artifacts"]["android"]
deps = {
    "third_party/skity_release/android/" + artifact["filename"]: {
        "type": "http",
        "url": artifact["url"],
        "sha256": artifact["sha256"],
        "decompress": False,
        "ignore_in_git": True,
    }
}
