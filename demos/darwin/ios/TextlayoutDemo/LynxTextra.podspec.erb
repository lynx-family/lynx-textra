Pod::Spec.new do |s|
  s.name             = 'LynxTextra'
  s.version          = '<%= ENV["VERSION"] %>'
  s.source           = { :http => '<%= ENV["PODSPEC_URL"] %>' }
  s.summary          = 'A powerful text layout component for iOS.'
  s.description      = 'LynxTextra provides advanced text layout capabilities for mobile applications.'
  s.homepage         = 'https://github.com/lynx-family/lynx-textra'
  s.license          = { :type => 'MIT', :file => 'LICENSE' }
  s.author           = { 'hfuttyh' => 'hfuttyh@gmail.com' }
  s.static_framework = true

  s.ios.deployment_target = '12.0'

  s.vendored_frameworks = 'LynxTextra.xcframework'

  s.frameworks = 'UIKit', 'CoreText'
end