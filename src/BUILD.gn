source_set("skshaper") {
  public_configs = [ ":skshaper_public" ]

  include_dirs = [ "$prj_root/public" ]
  configs += [ ":textlayout_internal" ]
  defines = []
  deps = []

  # System font adjustments use JNI only when the Java implementation is built.
  if (enable_javashaper) {
    deps += [ ":javashaper" ]
  }
  sources = []
  if (is_android) {
    configs += [ ":icu" ]
    sources += [ "$prj_root/src/textlayout/utils/icu_wrapper.cc" ]
  } else if (is_harmony) {
    configs += [ ":icu" ]
    sources += [ "$prj_root/src/textlayout/utils/icu_wrapper_static.cc" ]
  }

  sources += [
    "$prj_root/src/ports/shaper/skshaper/font.h",
    "$prj_root/src/ports/shaper/skshaper/one_line_shaper.cc",
    "$prj_root/src/ports/shaper/skshaper/one_line_shaper.h",
    "$prj_root/src/ports/shaper/skshaper/run.cc",
    "$prj_root/src/ports/shaper/skshaper/run.h",
    "$prj_root/src/ports/shaper/skshaper/script_run_iterator.h",
    "$prj_root/src/ports/shaper/skshaper/shaper_skshaper.cc",
    "$prj_root/src/ports/shaper/skshaper/shaper_skshaper.h",
    "$prj_root/src/ports/shaper/skshaper/sk_shaper.cc",
    "$prj_root/src/ports/shaper/skshaper/sk_shaper.h",
    "$prj_root/src/textlayout/utils/mutex.h",
  ]

  sources += [
    "$prj_root/src/ports/shaper/skshaper/harfbuzz_lib.cc",
    "$prj_root/src/ports/shaper/skshaper/sk_shaper_harfbuzz.cc",
  ]
  defines += [ "SK_SHAPER_HARFBUZZ_AVAILABLE" ]
  if (!is_win) {
    defines += [ "HAVE_PTHREADS" ]
  }

  # Android must keep HarfBuzz in the separately loaded platform library,
  # including embedders that provide their own config or override the default.
  if (dynamic_load_harfbuzz || is_android) {
    sources += [
      "$prj_root/src/ports/shaper/skshaper/harfbuzz_lib_runtime.cc",
      "$prj_root/src/ports/shaper/skshaper/sk_shaper_platform.cc",
    ]
    defines += [ "HARFBUZZ_LIB_NAME=\"libharfbuzz.so\"" ]
    public_configs += [ "//third_party/harfbuzz:harfbuzz_config" ]
  } else {
    sources += [
      "$prj_root/src/ports/shaper/skshaper/harfbuzz_lib_builtin.cc",
      "$prj_root/src/ports/shaper/skshaper/sk_shaper_platform_dummy.cc",
    ]
    deps += [ "//third_party/harfbuzz" ]
  }
}

config("ctshaper_public") {
  include_dirs = [ "$prj_root/src/ports/shaper/coretext/" ]
  defines = [ "ENABLE_CTSHAPER" ]
  if (is_ios) {
    defines += [ "TEXTRA_ENABLE_IOS_BACKEND" ]
  }
  if (is_mac) {
    defines += [ "TEXTRA_ENABLE_MACOS_BACKEND" ]
  }
}

config("harmony_public") {
  include_dirs = [ "$prj_root/src/ports/shaper/harmony" ]
  defines = [ "TEXTRA_ENABLE_OHOS_BACKEND" ]
}

config("lvgl_public") {
  include_dirs = [ "$prj_root/third_party" ]
  defines = [ "TEXTRA_ENABLE_LVGL_BACKEND" ]
}

# Built-in platform adapters; Skia and Skity remain host supplied.
source_set("native_platform") {
  configs += [ ":textlayout_internal" ]
  cflags_cc = [ "-fno-exceptions" ]

  # Keep the original CoreText registration API for minimum-SDK compatibility.
  cflags_objcc = [
    "-fno-exceptions",
    "-fobjc-arc",
    "-Wno-error=deprecated-declarations",
  ]
  sources = [ "ports/native/native_helpers.h" ]
  deps = []
  if (enable_javashaper) {
    deps += [ ":javashaper" ]
    sources += [
      "ports/native/android.cc",
      "ports/native/java/buffer_output_stream.h",
      "ports/native/java/java_canvas_helper.h",
    ]
  }
  if (enable_ctshaper) {
    configs += [ ":ctshaper_public" ]
    if (is_ios) {
      sources += [
        "ports/native/ios.mm",
        "ports/native/ios/coregraphics_gradient.h",
        "ports/native/ios/ios_canvas_base.h",
        "ports/native/ios/ios_font_manager.h",
        "ports/native/ios/typeface_coretext.h",
      ]
      frameworks = [
        "UIKit.framework",
        "CoreText.framework",
        "CoreGraphics.framework",
      ]
    } else if (is_mac) {
      sources += [
        "ports/native/ios/coregraphics_gradient.h",
        "ports/native/ios/ios_font_manager.h",
        "ports/native/ios/typeface_coretext.h",
        "ports/native/mac.mm",
        "ports/native/mac/mac_canvas_base.h",
      ]
      frameworks = [
        "AppKit.framework",
        "CoreText.framework",
        "CoreGraphics.framework",
      ]
    }
  }
  if (enable_harmony) {
    configs += [ ":harmony_public" ]
    sources += [
      "ports/native/ark_graphics/ag_canvas_helper.h",
      "ports/native/ark_graphics/ag_font_manager.h",
      "ports/native/ark_graphics/ag_gradient.h",
      "ports/native/ark_graphics/ag_typeface_helper.h",
      "ports/native/ohos.cc",
    ]
  }
  if (enable_lvglshaper) {
    configs += [ ":lvgl_public" ]
    sources += [
      "ports/native/lvgl.cc",
      "ports/native/lvgl/lvgl_canvas_helper.h",
      "ports/native/lvgl/lvgl_font_manager.h",
      "ports/native/lvgl/lvgl_typeface.h",
      "ports/shaper/lvgl/lvgl_canvas_helper.cc",
      "ports/shaper/lvgl/lvgl_font_manager.cc",
      "ports/shaper/lvgl/lvgl_typeface.cc",
      "ports/shaper/lvgl/lvgl_typeface_cjk.h",
      "ports/shaper/lvgl/lvgl_typeface_montserrat.h",
    ]
  }
}

# Per-object callback adapters and C entry points used by shaping ports.
source_set("backend") {
  defines = [ "TEXTRA_CAPI_BUILD" ]
  configs += [ ":textlayout_internal" ]
  cflags_cc = [ "-fno-exceptions" ]
  sources = [
    "capi/textra_backend_adapters.h",
    "capi/textra_callback_utils.h",
    "capi/textra_canvas.cc",
    "capi/textra_font_manager.cc",
    "capi/textra_typeface.cc",
  ]
}

source_set("capi") {
  configs += [ ":textlayout_internal" ]

  # Compile optional runtime hooks for the selected shaping ports.
  if (enable_harmony) {
    configs += [ ":harmony_public" ]
  }
  if (enable_lvglshaper) {
    configs += [ ":lvgl_public" ]
  }
  public_configs = [ ":textlayout_public" ]
  deps = [ ":textlayout" ]
  defines = [ "TEXTRA_CAPI_BUILD" ]
  if (enable_javashaper) {
    defines += [ "TEXTRA_ENABLE_ANDROID_BACKEND" ]
  }
  cflags_cc = [ "-fno-exceptions" ]
  cflags_objcc = [
    "-fno-exceptions",
    "-fobjc-arc",
  ]
  sources = [
    "capi/textra_android_runtime.cc",
    "capi/textra_callback_adapters.cc",
    "capi/textra_callbacks.cc",
    "capi/textra_canvas_proxy.h",
    "capi/textra_common.cc",
    "capi/textra_draw_adapter.cc",
    "capi/textra_drawer.cc",
    "capi/textra_enum_checks.h",
    "capi/textra_font.cc",
    "capi/textra_gradient.cc",
    "capi/textra_internal.h",
    "capi/textra_layout.cc",
    "capi/textra_paragraph.cc",
    "capi/textra_paragraph_style.cc",
    "capi/textra_platform_internal.h",
    "capi/textra_style.cc",
    "capi/textra_support.cc",
  ]
}
