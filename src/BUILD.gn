declare_args() {
  textlayout_use_local_config = true
  textlayout_use_lru_cache = true
  textlayout_boundary_analyst = "simple"
  textlayout_dynamic_load_harfbuzz = is_android
  textlayout_is_lvgl = false
}

if (textlayout_use_local_config) {
  import("../config.gni")
}

if (!defined(use_lru_cache)) {
  use_lru_cache = textlayout_use_lru_cache
}
if (!defined(boundary_analyst)) {
  boundary_analyst = textlayout_boundary_analyst
}
if (!defined(dynamic_load_harfbuzz)) {
  dynamic_load_harfbuzz = textlayout_dynamic_load_harfbuzz
}
if (!defined(is_lvgl)) {
  is_lvgl = textlayout_is_lvgl
}

declare_args() {
  prj_root = rebase_path("..")

  # Platforms select defaults; backend macros describe the implementations
  # actually compiled into the library, independently of the target OS macros.
  enable_javashaper = is_android && !is_lvgl
  enable_skshaper = is_android || is_mac || is_harmony || is_win || is_linux ||
                    target_cpu == "wasm"
  enable_ctshaper = (is_ios || is_mac) && !is_lvgl
  enable_harmony = is_harmony
  enable_minikin = false
  enable_lvglshaper = is_lvgl
  if (is_lvgl) {
    enable_javashaper = false
    enable_ctshaper = false
    enable_harmony = false
  }
}

